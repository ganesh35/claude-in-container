# Copy to .env and adjust. Never commit .env.

# Host folder mounted as /workspace — the only files Claude can see
WORKSPACE_DIR=./workspace
# Host folder mounted as /home/node — keeps the Claude login and settings across restarts
CLAUDE_HOME_DIR=./home
# UID/GID the container runs as; match the owner of WORKSPACE_DIR (Unraid: 1000/100 or 99/100)
PUID=1000
PGID=1000

# Session name shown in the Claude app / claude.ai/code (defaults to the container hostname)
REMOTE_CONTROL_NAME=

# Claude Code version baked into the image at build time
CLAUDE_CODE_VERSION=2.1.283

# Optional: use an API key instead of the subscription login
ANTHROPIC_API_KEY=

# scripts/ settings
# Engine command; auto-detects docker, then podman. Use "sudo docker" where docker needs root (e.g. Unraid)
CONTAINER_ENGINE=
IMAGE=claude-in-container:local
CONTAINER_NAME=claude-in-container
