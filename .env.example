# Copy to .env and adjust. Never commit .env.

# The single host folder mounted as /data: your projects, plus .home with Claude's login, settings and tools.
# Several containers can share it (see CONTINUE and scripts/run.sh --name).
DATA_DIR=./data
# UID/GID the container runs as; must own DATA_DIR (Unraid: 1000/100 or 99/100)
PUID=1000
PGID=1000

# Session name shown in the Claude app / claude.ai/code (defaults to the container hostname)
REMOTE_CONTROL_NAME=
# Resume the last conversation on start; set false on every other container sharing DATA_DIR
CONTINUE=true

# Claude Code version baked into the image at build time
CLAUDE_CODE_VERSION=2.1.283

# Optional: use an API key instead of the subscription login (disables Remote Control)
ANTHROPIC_API_KEY=

# Tools installed into DATA_DIR/.home/.local on start, skipped when already at that version.
# Empty = not installed. Downloads are verified: SHA256 checksums, AWS CLI by its GPG signature.
GH_VERSION=2.101.0
YQ_VERSION=4.53.6
JQ_VERSION=1.8.2
TERRAFORM_VERSION=1.16.4
AWSCLI_VERSION=2.37.4
# Space-separated in quotes, version required: npm as name@version, Python CLIs (via uv) as name==version
NPM_TOOLS="pnpm@12.6.0 @usebruno/cli@4.2.0"
UV_TOOLS=

# scripts/ settings
# Engine command; auto-detects docker, then podman. Use "sudo docker" where docker needs root (e.g. Unraid)
CONTAINER_ENGINE=
# Local build (scripts/build.sh), or the published image: ghcr.io/ganesh35/claude-in-container:latest
IMAGE=claude-in-container:local
CONTAINER_NAME=claude-in-container
